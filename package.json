{
  "name": "sales-proposal-builder",
  "version": "0.1.0",
  "private": true,
  "description": "A white-label Claude Skill that turns a client brief into a branded IT services proposal (.docx).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.skill.json",
    "typecheck": "tsc -p tsconfig.skill.json --noEmit && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "logos": "node tools/make-logos.ts",
    "probe:zip": "node spikes/zip-probe.ts",
    "probe:api": "node spikes/probe-api.ts",
    "preview": "node tools/preview.ts",
    "package": "node tools/package.ts",
    "evals": "node evals/harness/run.ts",
    "screenshots": "node tools/preview.ts --screenshots"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@types/node": "22.20.5",
    "docx": "9.15.0",
    "fflate": "0.8.3",
    "typescript": "7.0.2"
  }
}
